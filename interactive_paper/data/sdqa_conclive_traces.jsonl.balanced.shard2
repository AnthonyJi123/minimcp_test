{"id": "sdqa0158", "pool": "sdqa", "tier": "balanced", "audio_s": 3.42, "n_chunks": 4, "n_concurrent": 4, "gen_active_at_eot": true, "eot_score": 0.347, "eot_read_ms": 27, "reference_answer": "Ottoman Turkish", "query": "What was the lingua franca of the Ottoman Empire?", "transcript": "What was the lingua franca of the Ottoman Empire?", "mode": "local", "answer": "The lingua franca of the Ottoman Empire was Turkish, specifically Ottoman Turkish, which combined classical Turkish with Arabic and Persian vocabulary and script.", "answer_ms": 790}
