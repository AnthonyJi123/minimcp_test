{"id": "y0509", "pool": "know-commonsense", "n_q_chunks": 7, "onset_chunk": 6, "no_speak": false, "answer_text": "I think it's England.", "eot_seen": true, "n_ans_chunks": 2, "carrier_ended": null}
{"id": "y0517", "pool": "know-commonsense", "n_q_chunks": 7, "onset_chunk": 6, "no_speak": false, "answer_text": "Buying present s for others usually makes people happy. It's a thoughtful gesture that shows care and consideration, often bringing joy to the recipient.", "eot_seen": true, "n_ans_chunks": 9, "carrier_ended": null}
