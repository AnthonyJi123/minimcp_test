{"id": "swebq0009", "pool": "swebq", "tier": "balanced", "audio_s": 2.09, "n_chunks": 3, "n_concurrent": 3, "gen_active_at_eot": true, "eot_score": 0.3227, "eot_read_ms": 21, "reference_answer": "Shannon Pot", "query": "where does the shannon river start and end?", "transcript": "Where does the Shannon River start and end?", "mode": "escalated", "relay": "The River Shannon starts at the **Shannon Pot**, a small pool on the slopes of **Cuilcagh Mountain in County Cavan, Ireland**. It flows south and southwest through Ireland and ends by emptying into the **Atlantic Ocean via the Shannon Estuary**, between **Loop Head in County Clare** and **Kerry Head in County Kerry**.", "expert_answer": "The River Shannon starts at the **Shannon Pot**, a small pool on the slopes of **Cuilcagh Mountain in County Cavan, Ireland**.\n\nIt flows south and southwest through Ireland and ends by emptying into the **Atlantic Ocean via the Shannon Estuary**, between **Loop Head in County Clare** and **Kerry Head in County Kerry**.", "expert_latency_s": 4.7, "stall_ms": 28, "relay_ms": 1701}
