{"id": "sllama0223", "pool": "sllama", "n_q_chunks": 3, "onset_chunk": 3, "no_speak": false, "answer_text": "The drink made from the cacao tree is chocolate. Cacao beans are used to make chocolate, which can be turned into hot chocolate or other chocolate-based drinks.", "eot_seen": true, "n_ans_chunks": 10, "carrier_ended": null}
{"id": "sllama0231", "pool": "sllama", "n_q_chunks": 3, "onset_chunk": 3, "no_speak": false, "answer_text": "There are 24 hours in a day.", "eot_seen": true, "n_ans_chunks": 3, "carrier_ended": null}
