{"id": "swebq0077", "pool": "swebq", "n_q_chunks": 5, "onset_chunk": 4, "no_speak": false, "answer_text": "The United States Constitution sets up a federal government, meaning that power is divided between the national government and state governments. It also establish es a system of checks and balances to ensure no single branch of government becomes too powerful.", "eot_seen": true, "n_ans_chunks": 13, "carrier_ended": null}
