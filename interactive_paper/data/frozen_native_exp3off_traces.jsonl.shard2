{"id": "z0850", "pool": "know-commonsense", "n_q_chunks": 8, "onset_chunk": 7, "no_speak": false, "answer_text": "If someone is seeing new presence s at a birthday party, they might feel A. envy or B. jealousy if the gifts are impressive. They could also experience E. excitement from receiving nice presents or being surprised.", "eot_seen": true, "n_ans_chunks": 12, "carrier_ended": null}
