{"id": "z1050", "pool": "know-commonsense", "n_q_chunks": 6, "onset_chunk": 5, "no_speak": false, "answer_text": "The answer is E, dust bin.", "eot_seen": true, "n_ans_chunks": 3, "carrier_ended": null}
{"id": "z1058", "pool": "know-commonsense", "n_q_chunks": 9, "onset_chunk": 8, "no_speak": false, "answer_text": "Setting up framing, tru ss and beam are some of the first steps in new construction.", "eot_seen": true, "n_ans_chunks": 4, "carrier_ended": null}
