{"id": "sllama0003", "pool": "sllama", "n_q_chunks": 3, "onset_chunk": 3, "no_speak": false, "answer_text": "A menorah has seven branches. It's a traditional Jewish c andle holder used during Hanukkah, with one central candle for lighting the others.", "eot_seen": true, "n_ans_chunks": 9, "carrier_ended": null}
