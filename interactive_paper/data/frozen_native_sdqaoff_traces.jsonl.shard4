{"id": "sdqa0124", "pool": "sdqa", "n_q_chunks": 4, "onset_chunk": 3, "no_speak": false, "answer_text": "Sui generis means unique or one of a kind. It's used to describe something that is distinct from all others, like a person with an unusual talent or a place with its own special character.", "eot_seen": true, "n_ans_chunks": 10, "carrier_ended": null}
