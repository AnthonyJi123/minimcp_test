{"id": "sllama0025", "pool": "sllama", "n_q_chunks": 3, "onset_chunk": 3, "no_speak": false, "answer_text": "There are seven Harry Po tter books. They follow Harry's journey from his first year at Hogwarts to the final battle against V oldymort.", "eot_seen": true, "n_ans_chunks": 8, "carrier_ended": null}
