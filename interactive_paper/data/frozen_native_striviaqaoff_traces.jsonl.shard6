{"id": "striviaqa0214", "pool": "striviaqa", "n_q_chunks": 3, "onset_chunk": 3, "no_speak": false, "answer_text": "The model who first caused a storm in the Wonderbra campaign was Elle Mac Pherson. Her appearance in the ads sparked significant public debate about body image and fashion standards, making her one of the most talked-about models at the time.", "eot_seen": true, "n_ans_chunks": 14, "carrier_ended": null}
