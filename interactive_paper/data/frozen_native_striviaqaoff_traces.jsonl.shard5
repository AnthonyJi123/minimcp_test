{"id": "striviaqa0045", "pool": "striviaqa", "n_q_chunks": 6, "onset_chunk": 5, "no_speak": false, "answer_text": "The creator of the fictional school Grange Hill was English producer and screen writer Nick Pe rkins. He co- created the show alongside Tony McIner ney, bringing this iconic British television series to life in the 1980s.", "eot_seen": true, "n_ans_chunks": 13, "carrier_ended": null}
{"id": "striviaqa0053", "pool": "striviaqa", "n_q_chunks": 5, "onset_chunk": 4, "no_speak": false, "answer_text": "Guinness is believed to be the oldest continuous brewer in the country.", "eot_seen": true, "n_ans_chunks": 5, "carrier_ended": null}
