{"id": "striviaqa0085", "pool": "striviaqa", "n_q_chunks": 5, "onset_chunk": 4, "no_speak": false, "answer_text": "The last British athlete to compete in the Olympic 10 0 meters final was Sha ne McLeod at the 2 024 Paris Olympics. He reached the final, but unfortunately did not win a medal.", "eot_seen": true, "n_ans_chunks": 9, "carrier_ended": null}
