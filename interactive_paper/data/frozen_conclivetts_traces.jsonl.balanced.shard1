{"id": "q0467", "pool": "easy-chat", "tier": "balanced", "audio_s": 2.46, "n_chunks": 3, "n_concurrent": 3, "gen_active_at_eot": true, "eot_score": 0.0497, "eot_read_ms": 22, "reference_answer": null, "query": "What are some cardio machines at the gym?", "transcript": "What are some cardio machines at the gym?", "first_audio_ms": 643, "spoken_s": 9.6, "mode": "local", "answer": "Some cardio machines at the gym include treadmills, ellipticals, stationary bikes, rowing machines, stair climbers, and stair mills.", "answer_ms": 4455}
