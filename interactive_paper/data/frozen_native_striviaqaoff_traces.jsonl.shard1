{"id": "striviaqa0121", "pool": "striviaqa", "n_q_chunks": 5, "onset_chunk": 4, "no_speak": false, "answer_text": "The Canadian-born actress who starred in the movie Barb Wire was Sasha Grey. She' s known for her roles in both film and adult entertainment, and Barb Wire is one of her notable feature film appearances.", "eot_seen": true, "n_ans_chunks": 14, "carrier_ended": null}
