{"id": "striviaqa0097", "pool": "striviaqa", "n_q_chunks": 7, "onset_chunk": 6, "no_speak": false, "answer_text": "Shirley Temp les served as U. S. Ambassador to Zaire from 1 97 4 to 19 7 6.", "eot_seen": true, "n_ans_chunks": 10, "carrier_ended": null}
{"id": "striviaqa0105", "pool": "striviaqa", "n_q_chunks": 6, "onset_chunk": 5, "no_speak": false, "answer_text": "In 14 76, the first printing press was brought to London from Bruges by William Caxton.", "eot_seen": true, "n_ans_chunks": 7, "carrier_ended": null}
