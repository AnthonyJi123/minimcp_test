{"id": "striviaqa0233", "pool": "striviaqa", "n_q_chunks": 5, "onset_chunk": 4, "no_speak": false, "answer_text": "Charlotte is the largest city by population in North Carolina. It' s a major financial hub and a key part of the southeastern United States.", "eot_seen": true, "n_ans_chunks": 9, "carrier_ended": null}
