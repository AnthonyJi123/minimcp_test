{"id": "sllama0206", "pool": "sllama", "n_q_chunks": 3, "onset_chunk": 3, "no_speak": false, "answer_text": "Humans have five senses. They are sight, hearing, touch, taste and smell.", "eot_seen": true, "n_ans_chunks": 5, "carrier_ended": null}
