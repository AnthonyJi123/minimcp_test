{"id": "sllama0086", "pool": "sllama", "n_q_chunks": 3, "onset_chunk": 3, "no_speak": false, "answer_text": "There are eight planets in our solar system Mercury, V enus, Earth, Mar s, Ju piter, Sa turn, U ranus and Nept une.", "eot_seen": true, "n_ans_chunks": 9, "carrier_ended": null}
