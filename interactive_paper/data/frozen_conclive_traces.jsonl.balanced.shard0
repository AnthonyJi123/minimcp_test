{"id": "q0349", "pool": "easy-fact", "tier": "balanced", "audio_s": 8.35, "n_chunks": 9, "n_concurrent": 9, "gen_active_at_eot": true, "eot_score": 0.5778, "eot_read_ms": 35, "reference_answer": "Blue Riband", "query": "What name is given to the unofficial accolade awarded to the fastest passenger ship to cross the Atlantic in the westbound direction?", "transcript": "What name is given to the unofficial accolade awarded to the fastest passenger ship to cross the Atlantic in the westbound direction?", "mode": "escalated", "relay": "The unofficial accolade for the fastest passenger ship crossing the Atlantic in the westbound direction is called the Blue Riband.", "expert_answer": "The unofficial accolade is the **Blue Riband** (of the Atlantic).", "expert_latency_s": 4.41, "stall_ms": 37, "relay_ms": 918}
