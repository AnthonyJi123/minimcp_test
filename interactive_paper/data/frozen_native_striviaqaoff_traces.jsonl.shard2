{"id": "striviaqa0122", "pool": "striviaqa", "n_q_chunks": 6, "onset_chunk": 6, "no_speak": false, "answer_text": "The storyline of which 19 94 Disney animated film is based on the Shakespeare an tragedy Ham let? That would be The Lion King.", "eot_seen": true, "n_ans_chunks": 8, "carrier_ended": null}
