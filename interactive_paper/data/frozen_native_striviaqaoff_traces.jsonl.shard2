{"id": "striviaqa0154", "pool": "striviaqa", "n_q_chunks": 5, "onset_chunk": 4, "no_speak": false, "answer_text": "The popular resort of Monast ir is located in Tunisia. It' s a beautiful coastal destination known for its beaches, historic sites, and vibrant culture.", "eot_seen": true, "n_ans_chunks": 10, "carrier_ended": null}
