{"id": "swebq0104", "pool": "swebq", "tier": "always", "audio_s": 2.18, "n_chunks": 3, "n_concurrent": 3, "gen_active_at_eot": true, "eot_score": 0.3064, "eot_read_ms": 21, "reference_answer": "Padua", "query": "what is st anthony patron saint of?", "transcript": "Who is Saint Anthony patron saint of?", "mode": "escalated", "relay": "Saint Anthony of Padua is best known as the patron saint of lost things, especially lost articles. He's also considered a protector for those seeking help finding missing people or navigating difficult journeys.", "expert_answer": "Saint Anthony of Padua is best known as the patron saint of **lost things** (or lost articles). He is also associated with **lost people, the poor, travelers, and seekers of spiritual help**.", "expert_latency_s": 6.0, "stall_ms": 23, "relay_ms": 881}
{"id": "swebq0107", "pool": "swebq", "tier": "always", "audio_s": 1.81, "n_chunks": 2, "n_concurrent": 2, "gen_active_at_eot": true, "eot_score": 0.1239, "eot_read_ms": 21, "reference_answer": "Canada;Australia;South Africa;Zambia;United Kingdom;Zimbabwe;Uganda;New Zealand;Turks and Caicos Islands;Tanzania", "query": "where english is spoken?", "transcript": "Where English is spoken?", "mode": "escalated", "relay": "English is spoken in many countries worldwide. It's a primary language in places like the United States, the United Kingdom, Canada, Australia, New Zealand, and Ireland. It's also widely used across the globe as an official or second language in nations such as India, Singapore, South Africa, Nigeria, and the Philippines.", "expert_answer": "English is spoken in many countries worldwide. It is a primary language in countries such as:\n\n- United States\n- United Kingdom\n- Canada\n- Australia\n- New Zealand\n- Ireland\n\nIt is also widely used as an official or second language in many countries, including India, Singapore, South Africa, Nigeria, and the Philippines.", "expert_latency_s": 2.54, "stall_ms": 22, "relay_ms": 1500}
