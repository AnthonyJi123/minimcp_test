{"id": "sdqa0037", "pool": "sdqa", "tier": "always", "audio_s": 4.18, "n_chunks": 5, "n_concurrent": 5, "gen_active_at_eot": true, "eot_score": 0.2277, "eot_read_ms": 20, "reference_answer": "1920 to 1933", "query": "When was the Prohibition Era in the US?", "transcript": "When was the prohibition era in the US?", "mode": "escalated", "relay": "The Prohibition era in the United States lasted from 1920 to 1933. It began when the 18th Amendment and the Volstead Act took effect in January 1920, and ended with the ratification of the 21st Amendment in December 1933.", "expert_answer": "The Prohibition era in the United States lasted from **1920 to 1933**.\n\nIt began when the **18th Amendment** and the **Volstead Act** took effect in **January 1920**, and ended with the ratification of the **21st Amendment** in **December 1933**.", "expert_latency_s": 1.6, "stall_ms": 22, "relay_ms": 1510}
