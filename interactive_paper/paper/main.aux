\@writefile{toc}{\contentsline {section}{\numberline {1}Introduction}{1}{section.1}\protected@file@percent }
\newlabel{sec:intro}{{1}{1}{Introduction}{section.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {(1)} Speech streams live into a small duplex-trained local model. \textbf  {(2)} A mid-network (L22) linear read decides in $\sim $30\,ms --- before the first output token --- so the expert call is already in flight while local decoding would just be starting. \textbf  {(3)} Easy queries stay local; hard ones escalate to a cloud expert. \textbf  {(4)} The \emph  {same talker speaks} the expert's answer in one continuous session, improving live spoken sessions (42.2\%$\to $63.3\%) and, frozen, public speech benchmarks (Speech TriviaQA 66.4\%$\to $86.0\%).}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:hero}{{1}{2}{\textbf {(1)} Speech streams live into a small duplex-trained local model. \textbf {(2)} A mid-network (L22) linear read decides in $\sim $30\,ms --- before the first output token --- so the expert call is already in flight while local decoding would just be starting. \textbf {(3)} Easy queries stay local; hard ones escalate to a cloud expert. \textbf {(4)} The \emph {same talker speaks} the expert's answer in one continuous session, improving live spoken sessions (42.2\%$\to $63.3\%) and, frozen, public speech benchmarks (Speech TriviaQA 66.4\%$\to $86.0\%)}{figure.1}{}}
